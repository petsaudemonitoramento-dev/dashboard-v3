# Obrigatória. Origem canônica da aplicação, sem barra final.
# Usada para montar TODOS os links de autenticação enviados por e-mail
# (confirmação, OAuth e recuperação de senha). Nenhum cabeçalho da requisição
# participa dessa decisão. Fora de loopback, precisa ser HTTPS.
# Produção: https://maeaps.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://nyexakdyxtstcyycmlng.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Exclusiva do servidor. Necessária para ingestão SIAPS e listagem de auth.users.
# Nunca use prefixo NEXT_PUBLIC_ e nunca versione o valor real.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Observabilidade opcional. Sem DSN, o SDK permanece desativado e o build segue.
# A DSN identifica o endpoint do projeto e pode ser pública; nenhum PII padrão é enviado.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Somente no ambiente de build da Vercel, para upload privado de source maps.
# Nunca use prefixo NEXT_PUBLIC_ no token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
